@startuml bcontext

actor "Пользователь" as operator
component "Симулятор РЛС" as SW

operator - SW

@enduml

@startuml tcontext

actor "Пользователь" as operator

package "ОС Windows" {
    component "Симулятор РЛС" as SW
}

together{
    interface "мышь" as mouse
    interface "клавиатура" as keyboard
    mouse -[hidden]- keyboard
}

operator - mouse
operator - keyboard

mouse - SW
keyboard - SW

@enduml

@startuml containers

component "С1. Приложение" as sw <<GUI>> {
    component "C1a. Frontend" as front <<TypeScript>>
    component "C1b. Backend" as  back <<Rust>>

    front <-> back : IPC
}
database "С2. База данных" as db

back <-> db : SQL

@enduml

@startuml c1-components

interface SQL
database "С2. База данных" as db


package "С1. Приложение" {
  component "С1.1 Модуль авторизации" as c11
  component "С1.2 Модуль профиля" as c12
  component "С1.3 Модуль настроек" as c13
  component "С1.4 Модуль истории" as c14
  component "С1.5 Модуль карты" as c15
  component "С1.6 Модуль симуляции" as c16
  component "С1.7 Модуль главного меню" as c17
  component "С1.8 Модуль событий" as c18
  
}

c11 - SQL
c12 - SQL
c13 - SQL
c18 - SQL
c14 - c12
c16 -- c15

c14-[hidden]-c16

c11-[hidden]-c12
c12-[hidden]-c13

SQL - db

@enduml

@startuml state-machine-color-obj
(*) --> Серый
Серый --> [пользователь:\nдвойное нажатие ЛКМ] Синий
Синий --> [модуль симуляции:\nБВС подтвержден] Зеленый
Синий --> [модуль симуляции:\nБВС не подтвержден] Красный
@enduml

@startuml state-machine
(*) --> Авторизация
Авторизация --> [Некорректный логин\пароль] Авторизация
Авторизация --> [Корректный логин\пароль] "Главное меню"
"Главное меню" --> [Нажатие кнопки "Тренировка"] "Настройки тренировки"
"Настройки тренировки" --> Тренировка
"Главное меню" --> [Нажатие кнопки "Профиль"] Профиль
"Главное меню" --> [Нажатие кнопки "Настройки"] Настройки 
Тренировка --> [Тренировка завершена] Статистика
Тренировка --> [Тренировка прервана] "Главное меню"
Профиль --> [Выход из профиля] Авторизация
Профиль --> [Просмотр истории] Статистика
Статистика --> "Главное меню"
@enduml

@startuml state-machine-training

(*) --> "Начальная генерация объектов"
"Начальная генерация объектов" --> "Обновление всех объектов"
"Обновление всех объектов" --> [Цикл] "Обновление всех объектов"
"Обновление всех объектов" --> [Кнопка пауза] "Приостановка симуляции"
"Приостановка симуляции" --> ["Кнопка продолжить"] "Обновление всех объектов"
"Обновление всех объектов" --> [Двойное нажатие ЛКМ] "Обновление конкретного объекта"
"Обновление конкретного объекта" --> "Обновление статистики"
"Обновление статистики" --> "Обновление всех объектов"
"Обновление всех объектов" --> [Время тренировки закончилось] "Отобразить статистику"
"Отобразить статистику" --> (*)

@enduml
